[Unit]
Description=GCSFS Autonomous PR Shepherd Daemon (Max 3 Concurrent PRs)
After=network.target

[Service]
Type=simple
User=princer_google_com
WorkingDirectory=/home/princer_google_com/dev/gcsfs-agent-ops
ExecStart=/usr/bin/python3 /home/princer_google_com/dev/gcsfs-agent-ops/scripts/shepherd_daemon.py --repo /home/princer_google_com/c2dev/gcsfs --target-slug fsspec/gcsfs --max-prs 3 --poll-interval 1800
Restart=always
RestartSec=60
StandardOutput=journal
StandardError=journal
Environment="PATH=/home/princer_google_com/.local/bin:/home/princer_google_com/.gemini/bin:/usr/local/bin:/usr/bin:/bin"
Environment="STORAGE_EMULATOR_HOST=http://localhost:4443"

[Install]
WantedBy=multi-user.target
